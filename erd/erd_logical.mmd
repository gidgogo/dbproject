%% KBO 야구 기록 DB 논리 ERD — tools/gen_erd_docs.py 자동 생성
%% 실선 = 식별 관계(부모 키가 자식 PK에 포함), 점선 = 비식별 관계
erDiagram
    player ||--o{ batter_game : "player_id"
    team_game ||..o{ batter_game : "game_id,team_id"
    team_season ||..o{ game : "away_team_id,season"
    team_season ||..o{ game : "home_team_id,season"
    stadium |o..o{ game : "stadium_id"
    game ||..o{ game_event : "game_id"
    player |o..o{ game_event : "player_id"
    team_game |o..o{ game_event : "game_id,team_id"
    game_event_type ||..o{ game_event : "event_type"
    game ||--o{ game_umpire : "game_id"
    umpire ||--o{ game_umpire : "umpire_id"
    team_game ||--o{ inning_score : "game_id,team_id"
    pa_result_type ||..o{ pa_result_code : "result_type"
    player ||..o{ pitch : "batter_id"
    game ||--o{ pitch : "game_id"
    player ||..o{ pitch : "pitcher_id"
    pitch_result |o..o{ pitch : "pitch_result_code"
    pitch_type |o..o{ pitch : "pitch_type_ko"
    player ||--o{ pitcher_game : "player_id"
    team_game ||..o{ pitcher_game : "game_id,team_id"
    batter_game ||--o{ plate_appearance : "game_id,player_id"
    pa_result_code ||..o{ plate_appearance : "result_code"
    player ||--o{ player_salary : "player_id"
    player ||--o{ player_season : "player_id"
    team_season ||--o{ player_season : "team_id,season"
    player ||--o{ season_batting_official : "player_id"
    team_season ||--o{ season_batting_official : "team_id,season"
    player ||--o{ season_pitching_official : "player_id"
    team_season ||--o{ season_pitching_official : "team_id,season"
    game ||--o{ team_game : "game_id"
    team ||--o{ team_game : "team_id"
    team_season ||--o{ team_rank_official : "team_id,season"
    stadium |o..o{ team_season : "home_stadium_id"
    team ||--o{ team_season : "team_id"
    team {
        d_team_id team_id PK "팀ID"
        varchar30 team_name "대표팀명"
        varchar20 city "연고지"
        d_season first_season "첫시즌"
    }
    stadium {
        smallint stadium_id PK "구장ID"
        varchar40 stadium_name "구장명"
        varchar20 city "지역"
        boolean is_dome "돔구장여부"
        integer capacity "수용인원"
    }
    team_season {
        d_team_id team_id PK,FK "팀ID"
        d_season season PK "시즌"
        varchar30 team_name "시즌팀명"
        varchar10 short_name "약칭"
        smallint home_stadium_id FK "홈구장ID"
    }
    player {
        d_player_id player_id PK "선수ID"
        d_person_name player_name "선수명"
        date birth_date "생년월일"
        smallint height_cm "신장"
        smallint weight_kg "체중"
        d_hand throws "투구손"
        d_hand bats "타격방향"
        varchar10 position "포지션"
        varchar200 career "경력"
        varchar60 draft_info "지명정보"
        d_season draft_year "지명연도"
        varchar30 join_info "입단정보"
        d_season join_year "입단연도"
        integer signing_bonus_10k "입단계약금"
        boolean is_retired "은퇴여부"
        timestamptz profile_crawled_at "프로필수집일시"
    }
    player_season {
        d_player_id player_id PK,FK "선수ID"
        d_season season PK,FK "시즌"
        d_team_id team_id PK,FK "팀ID"
        d_person_name name_in_season "시즌표기명"
        boolean is_batter "타자기록여부"
        boolean is_pitcher "투수기록여부"
        varchar3 uniform_no "등번호"
    }
    player_salary {
        d_player_id player_id PK,FK "선수ID"
        d_season season PK "시즌"
        integer salary_10k_krw "연봉(원화)"
        integer salary_usd "연봉(달러)"
        varchar30 source_text "연봉원문"
    }
    game {
        d_game_id game_id PK "경기ID"
        date game_date "경기일자"
        d_season season FK "시즌"
        d_team_id away_team_id FK "원정팀ID"
        d_team_id home_team_id FK "홈팀ID"
        smallint doubleheader_no "더블헤더번호"
        smallint series_id "경기구분"
        smallint stadium_id FK "구장ID"
        integer attendance "관중수"
        time start_time "개시시각"
        time end_time "종료시각"
        smallint duration_min "경기시간"
        varchar13 kbo_game_id "KBO경기ID"
    }
    team_game {
        d_game_id game_id PK,FK "경기ID"
        d_team_id team_id PK,FK "팀ID"
        char1 home_away "홈원정구분"
        char1 result "승패"
        d_count runs "득점"
        d_count hits "안타"
        d_count errors "실책"
        d_count walks_hbp "4사구"
    }
    inning_score {
        d_game_id game_id PK,FK "경기ID"
        d_team_id team_id PK,FK "팀ID"
        d_inning inning PK "이닝"
        d_count runs "이닝득점"
    }
    pa_result_type {
        varchar20 result_type PK "결과유형코드"
        varchar20 result_type_name "결과유형명"
        char2 batted_ball "타구종류"
        boolean is_at_bat "타수포함여부"
        boolean is_hit "안타여부"
        smallint total_bases "루타수"
        boolean is_walk "볼넷여부"
        boolean is_hbp "사구여부"
        boolean is_sac_fly "희생플라이여부"
        boolean is_sac_bunt "희생번트여부"
        boolean is_strikeout "삼진여부"
        boolean is_double_play "병살여부"
    }
    pa_result_code {
        smallint result_code PK "결과코드"
        varchar10 result_name "결과명"
        varchar20 result_type FK "결과유형코드"
        smallint fielder_pos "처리수비위치"
        varchar2 spray_dir "타구방향"
    }
    batter_game {
        d_game_id game_id PK,FK "경기ID"
        d_player_id player_id PK,FK "선수ID"
        d_team_id team_id FK "팀ID"
        smallint lineup_seq "라인업순서"
        smallint batting_order "타순"
        varchar12 positions "포지션이력"
        d_count at_bats "타수"
        d_count hits "안타"
        d_count rbi "타점"
        d_count runs "득점"
    }
    plate_appearance {
        d_game_id game_id PK,FK "경기ID"
        d_player_id player_id PK,FK "선수ID"
        d_inning inning PK "이닝"
        smallint seq_in_inning PK "이닝내순번"
        smallint result_code FK "결과코드"
    }
    pitcher_game {
        d_game_id game_id PK,FK "경기ID"
        d_player_id player_id PK,FK "선수ID"
        d_team_id team_id FK "팀ID"
        smallint appearance_seq "등판순서"
        char1 decision "승패세홀"
        d_outs outs_recorded "아웃카운트"
        d_count batters_faced "상대타자수"
        d_count at_bats "피타수"
        d_count pitches "투구수"
        d_count hits_allowed "피안타"
        d_count home_runs_allowed "피홈런"
        d_count walks_hbp "4사구"
        d_count strikeouts "탈삼진"
        d_count runs_allowed "실점"
        d_count earned_runs "자책점"
    }
    game_event_type {
        varchar10 event_type PK "기록유형"
        varchar30 name_en "영문명"
    }
    game_event {
        bigint event_id PK "기록ID"
        d_game_id game_id FK "경기ID"
        varchar10 event_type FK "기록유형"
        smallint seq "순번"
        d_player_id player_id FK "선수ID"
        d_team_id team_id FK "팀ID"
        d_person_name player_name_raw "원문선수명"
        d_inning inning "이닝"
        varchar100 detail "상세"
        varchar200 raw_text "원문"
    }
    umpire {
        smallint umpire_id PK "심판ID"
        d_person_name umpire_name "심판명"
    }
    game_umpire {
        d_game_id game_id PK,FK "경기ID"
        smallint umpire_id PK,FK "심판ID"
        smallint listed_order "표기순서"
    }
    pitch_type {
        varchar10 pitch_type_ko PK "구종명"
        char2 statcast_code "Statcast코드"
        varchar30 name_en "영문명"
        varchar10 pitch_group "구종군"
    }
    pitch_result {
        char1 pitch_result_code PK "투구결과코드"
        varchar20 result_name "투구결과명"
        char1 call_type "판정구분"
    }
    pitch {
        d_game_id game_id PK,FK "경기ID"
        integer pitch_seq PK "투구순번"
        d_inning inning "이닝"
        char1 half "초말"
        smallint at_bat_no "타석순번"
        smallint pitch_no "타석내투구번호"
        d_player_id pitcher_id FK "투수ID"
        d_player_id batter_id FK "타자ID"
        smallint balls "볼카운트(볼)"
        smallint strikes "볼카운트(스트라이크)"
        smallint outs "현재아웃수"
        varchar10 pitch_type_ko FK "구종명"
        smallint speed_kmh "구속"
        char1 pitch_result_code FK "투구결과코드"
        numeric6_3 plate_x "홈플레이트좌우위치"
        numeric6_3 plate_z "홈플레이트높이"
        numeric5_3 sz_top "스트라이크존상단"
        numeric5_3 sz_bot "스트라이크존하단"
        char1 batter_stance "타석방향"
        varchar100 pa_result_text "타석결과문자"
        varchar40 naver_pitch_id "네이버투구ID"
    }
    season_batting_official {

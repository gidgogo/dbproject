%% KBO 야구 기록 DB 논리 ERD — tools/gen_erd_docs.py 자동 생성
%% 실선 = 식별 관계(부모 키가 자식 식별자에 포함), 점선 = 비식별 관계
%% 논리 모델이므로 식별자는 업무키로 표시하고, 물리 설계에서 추가한 대리키 id는 생략한다(10장 테이블 기술서 참고)
erDiagram
    match_team ||..o{ batter_match : "match_id,team_id"
    player ||--o{ batter_match : "player_id"
    match_team ||--o{ inning_score : "match_id,team_id"
    team_season ||..o{ match : "away_team_id,season"
    team_season ||..o{ match : "home_team_id,season"
    stadium |o..o{ match : "stadium_id"
    match ||..o{ match_event : "match_id"
    match_team |o..o{ match_event : "match_id,team_id"
    player |o..o{ match_event : "player_id"
    match_event_type ||..o{ match_event : "event_type"
    match ||--o{ match_team : "match_id"
    team ||--o{ match_team : "team_id"
    match ||--o{ match_umpire : "match_id"
    umpire ||--o{ match_umpire : "umpire_id"
    pa_result_type ||..o{ pa_result_code : "result_type"
    match_team ||..o{ pitcher_match : "match_id,team_id"
    player ||--o{ pitcher_match : "player_id"
    batter_match ||--o{ plate_appearance : "match_id,player_id"
    pa_result_code ||..o{ plate_appearance : "result_code"
    player ||--o{ player_salary : "player_id"
    player ||--o{ player_season : "player_id"
    team_season ||--o{ player_season : "team_id,season"
    player ||--o{ season_batting_official : "player_id"
    team_season ||--o{ season_batting_official : "team_id,season"
    player ||--o{ season_pitching_official : "player_id"
    team_season ||--o{ season_pitching_official : "team_id,season"
    team_season ||--o{ team_rank_official : "team_id,season"
    stadium |o..o{ team_season : "home_stadium_id"
    team ||--o{ team_season : "team_id"
    team {
        d_team_id team_id PK "팀ID"
        varchar30 team_name "대표팀명"
        varchar20 city "연고지"
        d_season first_season "첫시즌"
    }
    stadium {
        integer stadium_id PK "구장ID"
        varchar40 stadium_name "구장명"
        varchar20 city "지역"
        boolean is_dome "돔구장여부"
        integer capacity "수용인원"
    }
    team_season {
        d_team_id team_id PK,FK "팀ID"
        d_season season PK "시즌"
        varchar30 team_name "시즌팀명"
        varchar10 short_name "약칭"
        integer home_stadium_id FK "홈구장ID"
    }
    player {
        d_player_id player_id PK "선수ID"
        d_person_name player_name "선수명"
        date birth_date "생년월일"
        integer height_cm "신장"
        integer weight_kg "체중"
        d_hand throws "투구손"
        d_hand bats "타격방향"
        varchar10 position "포지션"
        varchar200 career "경력"
        varchar60 draft_info "지명정보"
        d_season draft_year "지명연도"
        varchar30 join_info "입단정보"
        d_season join_year "입단연도"
        integer signing_bonus_10k "입단계약금"
        boolean is_retired "은퇴여부"
        timestamptz profile_crawled_at "프로필수집일시"
        varchar60 current_team_name "현재소속명"
        varchar3 current_uniform_no "현재등번호"
        text profile_source_url "프로필출처"
    }
    player_season {
        d_player_id player_id PK,FK "선수ID"
        d_season season PK,FK "시즌"
        d_team_id team_id PK,FK "팀ID"
        d_person_name name_in_season "시즌표기명"
        boolean is_batter "타자기록여부"
        boolean is_pitcher "투수기록여부"
        varchar3 uniform_no "시즌등번호"
    }
    player_salary {
        d_player_id player_id PK,FK "선수ID"
        d_season season PK "시즌"
        integer salary_10k_krw "연봉(원화)"
        integer salary_usd "연봉(달러)"
        varchar30 source_text "연봉원문"
    }
    match {
        d_match_id match_id PK "경기ID"
        date match_date "경기일자"
        d_season season FK "시즌"
        d_team_id away_team_id FK "원정팀ID"
        d_team_id home_team_id FK "홈팀ID"
        integer doubleheader_no "더블헤더번호"
        integer series_id "경기구분"
        integer stadium_id FK "구장ID"
        integer attendance "관중수"
        time start_time "개시시각"
        time end_time "종료시각"
        integer duration_min "경기시간"
        varchar13 kbo_match_id "KBO경기ID"
    }
    match_team {
        d_match_id match_id PK,FK "경기ID"
        d_team_id team_id PK,FK "팀ID"
        varchar1 home_away "홈원정구분"
        varchar1 result "승패"
        d_count runs "득점"
        d_count hits "안타"
        d_count errors "실책"
        d_count walks_hbp "4사구"
    }
    inning_score {
        d_match_id match_id PK,FK "경기ID"
        d_team_id team_id PK,FK "팀ID"
        d_inning inning PK "이닝"
        d_count runs "이닝득점"
    }
    pa_result_type {
        varchar20 result_type PK "결과유형코드"
        varchar20 result_type_name "결과유형명"
        varchar2 batted_ball "타구종류"
        boolean is_at_bat "타수포함여부"
        boolean is_hit "안타여부"
        integer total_bases "루타수"
        boolean is_walk "볼넷여부"
        boolean is_hbp "사구여부"
        boolean is_sac_fly "희생플라이여부"
        boolean is_sac_bunt "희생번트여부"
        boolean is_strikeout "삼진여부"
        boolean is_double_play "병살여부"
    }
    pa_result_code {
        integer result_code PK "결과코드"
        varchar10 result_name "결과명"
        varchar20 result_type FK "결과유형코드"
        integer fielder_pos "처리수비위치"
        varchar2 spray_dir "타구방향"
    }
    batter_match {
        d_match_id match_id PK,FK "경기ID"
        d_player_id player_id PK,FK "선수ID"
        d_team_id team_id FK "팀ID"
        integer lineup_seq "라인업순서"
        integer batting_order "타순"
        varchar12 positions "포지션이력"
        d_count at_bats "타수"
        d_count hits "안타"
        d_count rbi "타점"
        d_count runs "득점"
    }
    plate_appearance {
        d_match_id match_id PK,FK "경기ID"
        d_player_id player_id PK,FK "선수ID"
        d_inning inning PK "이닝"
        integer seq_in_inning PK "이닝내순번"
        integer result_code FK "결과코드"
    }
    pitcher_match {
        d_match_id match_id PK,FK "경기ID"
        d_player_id player_id PK,FK "선수ID"
        d_team_id team_id FK "팀ID"
        integer appearance_seq "등판순서"
        varchar1 decision "승패세홀"
        d_outs outs_recorded "아웃카운트"
        d_count batters_faced "상대타자수"
        d_count at_bats "피타수"
        d_count pitches "투구수"
        d_count hits_allowed "피안타"
        d_count home_runs_allowed "피홈런"
        d_count walks_hbp "4사구"
        d_count strikeouts "탈삼진"
        d_count runs_allowed "실점"
        d_count earned_runs "자책점"
    }
    match_event_type {
        varchar10 event_type PK "기록유형"
        varchar30 name_en "영문명"
    }
    match_event {
        bigint event_id PK "기록ID"
        d_match_id match_id FK "경기ID"
        varchar10 event_type FK "기록유형"
        integer seq "순번"
        d_player_id player_id FK "선수ID"
        d_team_id team_id FK "팀ID"
        d_person_name player_name_raw "원문선수명"
        d_inning inning "이닝"
        varchar100 detail "상세"
        varchar200 raw_text "원문"
    }
    umpire {
        integer umpire_id PK "심판ID"
        d_person_name umpire_name "심판명"
    }
    match_umpire {
        d_match_id match_id PK,FK "경기ID"
        integer umpire_id PK,FK "심판ID"
        integer listed_order "표기순서"
    }
    season_batting_official {
        d_player_id player_id PK,FK "선수ID"
        d_season season PK,FK "시즌"
        d_team_id team_id PK,FK "팀ID"
        d_total games "경기수"
        d_total plate_appearances "타석"
        d_total at_bats "타수"
        d_total runs "득점"
        d_total hits "안타"
        d_total doubles "2루타"
        d_total triples "3루타"
        d_total home_runs "홈런"
        d_total total_bases "루타"
        d_total rbi "타점"
        d_total sac_bunts "희생번트"
        d_total sac_flies "희생플라이"
        d_total walks "볼넷"
        d_total intentional_walks "고의4구"
        d_total hbp "사구"
        d_total strikeouts "삼진"
        d_total gidp "병살타"
        d_rate avg "타율"
        d_rate obp "출루율"
        d_slg slg "장타율"
        d_slg ops "OPS"
        timestamptz crawled_at "수집일시"
    }
    season_pitching_official {
        d_player_id player_id PK,FK "선수ID"
        d_season season PK,FK "시즌"
        d_team_id team_id PK,FK "팀ID"
        d_total games "경기수"
        d_total wins "승"
        d_total losses "패"
        d_total saves "세이브"
        d_total holds "홀드"
        d_outs outs_recorded "아웃카운트"
        d_total hits_allowed "피안타"
        d_total home_runs_allowed "피홈런"
        d_total walks "볼넷"
        d_total hbp "사구"
        d_total strikeouts "탈삼진"
        d_total runs_allowed "실점"
        d_total earned_runs "자책점"
        d_total batters_faced "상대타자수"
        d_total pitches "투구수"
        d_total complete_games "완투"
        d_total shutouts "완봉"
        d_total quality_starts "퀄리티스타트"
        d_total blown_saves "블론세이브"
        d_era era "평균자책점"
        d_era whip "WHIP"
        timestamptz crawled_at "수집일시"
    }
    team_rank_official {
        d_season season PK,FK "시즌"
        d_team_id team_id PK,FK "팀ID"
        date as_of_date PK "기준일"
        integer rank "순위"
        d_total games "경기수"
        d_total wins "승"
        d_total losses "패"
        d_total draws "무"
        d_rate win_pct "승률"
        numeric4_1 games_behind "게임차"
        varchar20 last10 "최근10경기"
        varchar10 streak "연속"
        timestamptz crawled_at "수집일시"
    }

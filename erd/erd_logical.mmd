        d_total total_bases "루타"
        d_total rbi "타점"
        d_total sac_bunts "희생번트"
        d_total sac_flies "희생플라이"
        d_total walks "볼넷"
        d_total intentional_walks "고의4구"
        d_total hbp "사구"
        d_total strikeouts "삼진"
        d_total gidp "병살타"
        d_rate avg "타율"
        d_rate obp "출루율"
        d_slg slg "장타율"
        d_slg ops "OPS"
